# Punjab Digital Community Supervision System (PDCSS) Environment Variables
PROJECT_NAME="Punjab Digital Community Supervision System"
ENVIRONMENT="development"
DEBUG=True

# Security Keys (NEVER use default keys in production!)
SECRET_KEY="generate_a_secure_random_secret_key_here_for_jwt_and_audit"
AUDIT_HMAC_SECRET="generate_a_secure_random_audit_hmac_secret_here"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_SERVER="db"
POSTGRES_PORT=5432
POSTGRES_USER="pdcss_user"
POSTGRES_PASSWORD="pdcss_secure_password_123"
POSTGRES_DB="pdcss_db"
DATABASE_URL="postgresql+asyncpg://pdcss_user:pdcss_secure_password_123@db:5432/pdcss_db"

# Keycloak IAM Configuration
KEYCLOAK_SERVER_URL="http://keycloak:8080"
KEYCLOAK_REALM="pdcss"
KEYCLOAK_CLIENT_ID="pdcss-backend"
KEYCLOAK_CLIENT_SECRET="pdcss-client-secret"

# MinIO S3 Object Storage
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="minio_admin"
MINIO_SECRET_KEY="minio_admin_secure_password"
MINIO_BUCKET_NAME="pdcss-media"
MINIO_SECURE=False

# Redis Configuration (Cache & Rate Limiting)
REDIS_HOST="redis"
REDIS_PORT=6379

# Nginx Configuration
DOMAIN_NAME="localhost"
